{
    "name": "guggach/laravel-db-temporal",
    "description": "Uni-temporal (transaction time) versioning for Laravel – automatic versioning on insert, update, and delete.",
    "keywords": [
        "laravel",
        "laravel package",
        "temporal database"
    ],
    "homepage": "https://github.com/guggach/laravel-db-temporal",
    "license": "MIT",
    "authors": [
        {
            "name": "Enrica",
            "email": "e.ruedin@guggach.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Guggach\\LaravelDbTemporal\\": "src",
            "Guggach\\LaravelDbTemporal\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guggach\\LaravelDbTemporal\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "./vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest",
        "test-coverage": "./vendor/bin/pest --coverage",
        "format": "./vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guggach\\LaravelDbTemporal\\LaravelDbTemporalServiceProvider"
            ],
            "aliases": {
                "LaravelDbTemporal": "Guggach\\LaravelDbTemporal\\Facades\\LaravelDbTemporal"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
