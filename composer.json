{
    "name": "guggach/laravel-db-temporal",
    "description": "The package issues a virtual DB which ensures bi-temporal functions.",
    "keywords": [
        "laravel",
        "laravel package",
        "temporal database"
    ],
    "homepage": "https://github.com/guggach/laravel-db-temporal",
    "license": "MIT",
    "authors": [
        {
            "name": "Enrica",
            "email": "e.ruedin@guggach.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "barryvdh/laravel-ide-helper": "^2.13",
        "illuminate/contracts": "^10.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.5",
        "nunomaduro/larastan": "^2.0.1",
        "orchestra/testbench": "^8.5",
        "pestphp/pest": "^2.6",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Guggach\\LaravelDbTemporal\\": "src",
            "Guggach\\LaravelDbTemporal\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guggach\\LaravelDbTemporal\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "./vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest",
        "test-coverage": "./vendor/bin/pest --coverage",
        "format": "./vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guggach\\LaravelDbTemporal\\LaravelDbTemporalServiceProvider"
            ],
            "aliases": {
                "LaravelDbTemporal": "Guggach\\LaravelDbTemporal\\Facades\\LaravelDbTemporal"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
